# Кладётся в /etc/logrotate.d/ufw
# ufw.log — самый быстрорастущий лог на VPN-сервере: сканеры долбятся
# круглосуточно, каждый пакет = строка UFW BLOCK.
/var/log/ufw.log
{
	daily
	rotate 30
	maxage 30
	missingok
	notifempty
	compress
	delaycompress
	sharedscripts
	postrotate
		[ -x /usr/lib/rsyslog/rsyslog-rotate ] && /usr/lib/rsyslog/rsyslog-rotate || true
	endscript
}
